# IMPACTOS — Cloudinary (OPTIONAL).
# The entire demo runs WITHOUT any of these using deterministic fixture media.
# Set a cloud name to serve real Cloudinary transformation URLs (which preserve
# the original public_id / provenance anchor through every derivative).
CLOUDINARY_CLOUD_NAME=

# Server-side only — never exposed to the client. Used for signed uploads /
# structured-metadata writes in a full deployment (not required for the demo).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Live web research for ORCHESTRA (OPTIONAL — demo uses seeded fixtures).
# When absent, ORCHESTRA runs the deterministic research engine.
SEARCH_API_KEY=
